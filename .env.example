# Leave DATABASE_URL unset to use the embedded PGlite database (dev/test, no setup required).
# Set it to a Supabase/Postgres connection string to use that instead.
# DATABASE_URL=postgres://user:password@host:5432/postgres

# Where the embedded PGlite database is stored on disk when DATABASE_URL is unset.
PGLITE_DIR=.data/pglite

# The first account is created automatically on an empty database.
STORE_USERNAME=admin
STORE_DISPLAY_NAME=Administrator
# Generate with: npm run hash-password -- "a-strong-password"
STORE_PASSWORD_HASH=

# Secret used to sign the session cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
